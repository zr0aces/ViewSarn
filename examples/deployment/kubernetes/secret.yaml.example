apiVersion: v1
kind: Secret
metadata:
  name: viewsarn-keys
type: Opaque
stringData:
  # Generate keys using: node scripts/generate-apikey.js -f apikeys.txt
  apikeys.txt: |
    # ViewSarn Production API Keys
    # Format: one key per line, # comments ignored
    api_sample_production_key_replace_before_deploying
